#!/bin/sh
# PROVIDE: zapd
# REQUIRE: LOGIN zapexec
# KEYWORD: shutdown
#
# zapd —— ZAP 面板业务主进程（FreeBSD 版）
#
# 对应 systemd 的 scripts/systemd/zapd.service（User=zapadm、
# WorkingDirectory=/usr/local/zap）。FreeBSD 由 rc(8) 管理：启停用 service(8)，
# 开机自启开关是 /etc/rc.conf 里的 zapd_enable（交给 sysrc 写）。
#
# 与 OpenBSD 版有两个关键差异，改动时别照搬：
#   1. FreeBSD 的 rc.subr 没有 OpenBSD 的 rc_bg，而 zapd 是前台进程（systemd 里
#      是 Type=simple），所以要用 daemon(8) 包一层负责后台化与 pidfile；
#   2. 第三方服务的脚本装在 /usr/local/etc/rc.d/，不是 /etc/rc.d/。
#
# 注意：此脚本尚未在 FreeBSD 上实测（仓库 CI 只覆盖 Linux）。若启动后进程立刻
# 退出，优先检查下面的 zapd_start 与 daemon(8) 的 -p 参数。

. /etc/rc.subr

name="zapd"
rcvar="zapd_enable"
desc="ZAP free server control panel (zapd)"

# zapd 是前台进程，用 daemon(8) 后台化：
#   -f  丢弃 stdin/stdout/stderr（systemd 下则由 journald 接管）
#   -p  写「子进程」的 pid —— 别写成 -P，那是 daemon 监督进程自己的 pid
#   -u  降到 zapadm 运行，对应 unit 的 User=
# 外面包一层 sh -c 是因为 daemon(8) 没有工作目录选项（它的 -c 是切到 /，方向
# 相反），而 zapd 用相对路径读写 data/ 下的内容。用 exec 收尾，保证写进
# pidfile 的是 zapd 自己的 pid 而不是 sh 的。
command="/usr/sbin/daemon"
procname="/usr/local/zap/zapd"
pidfile="/var/run/${name}.pid"

zapd_start() {
	/usr/sbin/daemon -f -p "${pidfile}" -u zapadm \
		/bin/sh -c 'cd /usr/local/zap && exec /usr/local/zap/zapd'
}
start_cmd="zapd_start"

load_rc_config "${name}"
run_rc_command "$1"
