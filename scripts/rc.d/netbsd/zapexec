#!/bin/sh
# PROVIDE: zapexec
# REQUIRE: LOGIN
# BEFORE: zapd
# KEYWORD: shutdown
#
# zapexec —— ZAP 面板的 root 特权执行守护进程（NetBSD 版）
#
# 对应 scripts/systemd/zapexec.service：以 root 运行（unit 里没有 User=），
# unit 的 Environment= 与 RuntimeDirectory= 在下面手工补齐。
#
# 顺序要求与 systemd 侧一致：zapexec 必须先于 zapd 启动，全新机器上 exec.key
# 由 zapexec 首启生成（对应 unit 的 After=zapexec.service）。
#
# 注意：此脚本尚未在 NetBSD 上实测（仓库 CI 只覆盖 Linux）。

. /etc/rc.subr

name="zapexec"
rcvar="zapexec"

# unit 里的 Environment=ZAP_PATH=/usr/local/zap
export ZAP_PATH=/usr/local/zap

# 与 zapd 同样的前台进程处理：command_background 负责后台化与 pidfile。
# 这里用 sh -c 是顺带补 unit 的 RuntimeDirectory=zap（systemd 自动建，NetBSD
# 得自己来）。非 Linux 平台没有 /run，socket 放在 /var/run —— 与 zap-proto 的
# DEFAULT_EXEC_SOCKET 保持一致。
command="/bin/sh"
command_args="-c 'install -d -o root -g wheel -m 0750 /var/run/zap && exec /usr/local/zap/zapexec --socket /var/run/zap/exec.sock --secret /etc/zap/exec.key --client-user zapadm'"
command_background=true
pidfile="/var/run/${name}.pid"
procname="/usr/local/zap/zapexec"

load_rc_config "${name}"
run_rc_command "$1"
