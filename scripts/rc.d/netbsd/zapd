#!/bin/sh
# PROVIDE: zapd
# REQUIRE: LOGIN zapexec
# KEYWORD: shutdown
#
# zapd —— ZAP 面板业务主进程（NetBSD 版）
#
# 对应 systemd 的 scripts/systemd/zapd.service（User=zapadm、
# WorkingDirectory=/usr/local/zap）。NetBSD 由 rc(8) 管理，用 rcctl(8) 开关；
# 注意它的启用变量是 /etc/rc.conf 里的 zapd=YES，没有 _enable 后缀（这是
# NetBSD 与 FreeBSD 的差异，由 rcctl 处理，本脚本不用管）。
#
# 与 OpenBSD 版的差异：NetBSD 的 rc.subr 没有 rc_bg，改用 command_background
# 让 rc.subr 负责后台化与 pidfile；降权用 ${name}_user 而不是 daemon_user。
#
# 注意：此脚本尚未在 NetBSD 上实测（仓库 CI 只覆盖 Linux）。若服务起不来，
# 优先检查 command_background 与 ${name}_user 这组 NetBSD 专有的组合。

. /etc/rc.subr

name="zapd"
rcvar="zapd"

# zapd 是前台进程（Type=simple）。NetBSD 没有 FreeBSD 的 daemon(8)，所以交给
# rc.subr 的 command_background 后台化并把 pid 写进 pidfile。
# 外面这层 sh -c 是为了补 unit 里的 WorkingDirectory：rc.subr 没有工作目录
# 概念，而 zapd 用相对路径读写 data/ 下的内容。exec 收尾保证 pid 一致。
command="/bin/sh"
command_args="-c 'cd /usr/local/zap && exec /usr/local/zap/zapd'"
command_background=true
pidfile="/var/run/${name}.pid"
# 对应 unit 的 User=zapadm：rc.subr 会据此降权运行
zapd_user="zapadm"
# rc.subr 默认拿 command 的名字去匹配进程（那会是 sh），实际进程是 zapd
procname="/usr/local/zap/zapd"

load_rc_config "${name}"
run_rc_command "$1"
