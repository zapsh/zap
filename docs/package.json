{
  "name": "zap-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ZAP 面板文档站（VitePress）：使用指南 + API 参考，中英双语",
  "scripts": {
    "gen:api": "node scripts/gen-api.mjs",
    "dev": "npm run gen:api && vitepress dev .",
    "dev:host": "npm run gen:api && vitepress dev . --host 0.0.0.0",
    "build": "npm run gen:api && vitepress build .",
    "preview": "vitepress preview .",
    "preview:host": "vitepress preview . --host 0.0.0.0"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
