{
  "name": "zap-admin-vue3",
  "version": "1.0.2",
  "description": "A Vue 3 admin template with Element Plus, Pinia, and Vite.",
  "build-date": "",
  "author": "Zap Team <z@zap.cn>",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "vue",
    "vue3",
    "element-plus",
    "pinia",
    "vite",
    "admin-template"
  ],
  "homepage": "https://zap.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/zapsh/zap-admin-vue3.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "prod": "vite --mode production",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@codemirror/lang-go": "^6.0.1",
